/* Spotlight: tarjeta clara, redondeada, centrada. */
* {
  font: "Inter 15";
  bg: #f6f6f8ee;
  fg: #1d1d1f;
  fg-soft: #6e6e73;
  sel: #0a60ffff;
  background-color: transparent;
  text-color: @fg;
}
window {
  location: north; anchor: north; y-offset: 20%;
  width: 640px; border-radius: 16px;
  background-color: @bg; border: 1px; border-color: #00000022;
}
mainbox { children: [inputbar, listview]; padding: 14px; spacing: 10px; }
inputbar { padding: 8px 10px; spacing: 10px; children: [prompt, entry]; }
prompt { text-color: @fg-soft; }
entry { placeholder: "Spotlight"; placeholder-color: @fg-soft; }
listview { lines: 7; fixed-height: false; scrollbar: false; spacing: 2px; }
element { padding: 8px 10px; border-radius: 8px; spacing: 10px; }
element selected { background-color: @sel; text-color: #ffffff; }
element-icon { size: 1.6em; }
