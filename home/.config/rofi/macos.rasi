* { font: "Inter 9"; }
window { location: center; width: 52%; background-color: #3c3c3c0a; border-radius: 22px; padding: 14px 18px; border: 0; }
mainbox { children: [ listview ]; background-color: transparent; }
listview { layout: horizontal; lines: 8; columns: 1; fixed-columns: false; scrollbar: false; spacing: 4px; background-color: transparent; }
element { orientation: vertical; padding: 8px 6px 4px 6px; border-radius: 12px; background-color: transparent; text-color: #ffffff; spacing: 4px; border: 2px; border-color: transparent; }
element selected { background-color: #00000028; border-color: #ffffffcc; }
element-icon { size: 5.2em; horizontal-align: 0.5; background-color: transparent; }
element-text { horizontal-align: 0.5; text-color: inherit; background-color: transparent; }
